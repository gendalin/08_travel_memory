# Copy to .env and fill in. .env is git-ignored — never commit real keys.
#
#   cp .env.example .env
#
# Both keys are used by preprocessing only (Node side). Neither reaches the
# browser. Neither is written into data/demo_tokyo_v1/.

# --- Google Maps Places API ---------------------------------------------
# Enriches saved places with coordinates, category, price level, opening hours.
# Without it, places can still be identified (the Takeout URL carries a stable
# ftid) but cannot be categorised reliably.
#
# Restrict this key before use:
#   - API restriction: Places API (New) only
#   - Application restriction: IP addresses (this machine), or None for local CLI
#   - Set a low daily quota cap in the Cloud console
GOOGLE_MAPS_API_KEY=

# --- OpenAI API -----------------------------------------------------------
# Reads photo content and screenshot text to derive interest categories.
# Use a project-scoped key with a spend limit, not your account-wide key.
OPENAI_API_KEY=
